# Copie a .env (no lo suba a Git). Variables usadas por INCASOFT / Django.

# --- Obligatorio en producción (Render) ---
# DJANGO_SECRET_KEY=...   # o SECRET_KEY=... (≥40 caracteres en producción)
# DJANGO_DEBUG=0
# DJANGO_ALLOWED_HOSTS=mi-app.onrender.com

# PostgreSQL: si la BD ya existe en Render (ej. incasoft-db), en el Web Service →
# Connect → Link database. Render define DATABASE_URL solo; no pegue credenciales en Git.
# DATABASE_URL=  (solo local o copia temporal; en Render use el enlace del panel)

# SSL al parsear DATABASE_URL: por defecto True si el host parece Render/AWS;
# en Postgres local sin SSL: DATABASE_SSL_REQUIRE=0

# CSRF en HTTPS (varias URLs separadas por coma)
# DJANGO_CSRF_TRUSTED_ORIGINS=https://mi-app.onrender.com

# Redirección HTTP→HTTPS (por defecto activa si DJANGO_DEBUG=0)
# DJANGO_SECURE_SSL_REDIRECT=1

# --- Correo (recuperación de contraseña) ---
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=1
# EMAIL_HOST_USER=su_cuenta@gmail.com
# EMAIL_HOST_PASSWORD=contraseña_de_aplicación
# DJANGO_DEFAULT_FROM_EMAIL=su_cuenta@gmail.com
# DJANGO_SITE_NAME=INCASOFT Solutions

# --- Google Gemini (reportes → análisis IA) ---
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_MODEL_FALLBACKS=gemini-2.5-flash,gemini-1.5-flash
# GEMINI_MAX_RETRIES=2
